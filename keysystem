-- RIVALS Work.ink Key System
local Players = game:GetService("Players")
local HttpService = game:GetService("HttpService")
local player = Players.LocalPlayer

local Config = {
    WorkInkURL = "https://work.ink/30bv/unlok-all-aim-assist-key",
    WorkInkLinkId = 5007119,
    Secret = "RIVALS_ACCESS_5007119",
    MainScriptURL = "https://raw.githubusercontent.com/m4rcogmz/unllock-all-and-aim-assist/refs/heads/main/UA",
    KeyFileName = "RivalsWorkInkKey.txt",
    HubName = "RIVALS",
    HubDescription = "Unlock All & Aim Assist",
}

local function resolveRequest()
    local env = _G
    if type(getgenv) == "function" then
        local ok, value = pcall(getgenv)
        if ok and type(value) == "table" then
            env = value
        end
    end

    local candidates = {
        type(env) == "table" and env.request or nil,
        type(env) == "table" and env.http_request or nil,
        type(request) == "function" and request or nil,
        type(http_request) == "function" and http_request or nil,
    }

    if type(syn) == "table" then candidates[#candidates + 1] = syn.request end
    if type(http) == "table" then candidates[#candidates + 1] = http.request end
    if type(fluxus) == "table" then candidates[#candidates + 1] = fluxus.request end
    if type(krnl) == "table" then candidates[#candidates + 1] = krnl.request end

    for _, fn in ipairs(candidates) do
        if type(fn) == "function" then
            return fn
        end
    end
end

local function verifyKey(key)
    if type(key) ~= "string" then return false, "Invalid key." end
    key = key:match("^%s*(.-)%s*$") or ""
    if key == "" then return false, "Enter a key." end

    local req = resolveRequest()
    if not req then
        return false, "HTTP requests are not supported."
    end

    local url = "https://work.ink/_api/v2/token/isValid/" .. HttpService:UrlEncode(key)

    local ok, response = pcall(req, {
        Url = url,
        URL = url,
        Method = "GET",
        Headers = {["Accept"] = "application/json"},
    })

    if not ok then
        return false, "Could not contact Work.ink."
    end

    if type(response) == "string" then
        response = {StatusCode = 200, Body = response}
    end

    if type(response) ~= "table" then
        return false, "Invalid Work.ink response."
    end

    local status = tonumber(response.StatusCode) or tonumber(response.Status) or 200
    if status < 200 or status >= 300 then
        return false, "Work.ink HTTP " .. tostring(status)
    end

    local body = response.Body or response.body or response.ResponseBody
    if type(body) ~= "string" then
        return false, "Invalid Work.ink response."
    end

    local decodeOk, data = pcall(HttpService.JSONDecode, HttpService, body)
    if not decodeOk or type(data) ~= "table" then
        return false, "Invalid Work.ink JSON."
    end

    if data.valid ~= true then
        return false, "Invalid or expired key."
    end

    if type(data.info) ~= "table"
        or tonumber(data.info.linkId) ~= Config.WorkInkLinkId then
        return false, "This key is not from the official link."
    end

    return true, "Success"
end

local function saveKey(key)
    if type(writefile) == "function" then
        pcall(writefile, Config.KeyFileName, key)
    end
end

local function getSavedKey()
    if type(isfile) == "function"
        and type(readfile) == "function"
        and isfile(Config.KeyFileName) then
        local ok, value = pcall(readfile, Config.KeyFileName)
        if ok and type(value) == "string" and value ~= "" then
            return value
        end
    end
end

local function copyLink()
    local fn = setclipboard or toclipboard
    if type(fn) == "function" then
        pcall(fn, Config.WorkInkURL)
        return true
    end
    return false
end

local function startMainScript()
    if Config.MainScriptURL == "PUT_YOUR_MAIN_SCRIPT_URL_HERE" then
        return false, "Set MainScriptURL first."
    end

    _G[Config.Secret] = true

    local ok, source = pcall(function()
        return game:HttpGet(Config.MainScriptURL)
    end)

    if not ok or type(source) ~= "string" then
        _G[Config.Secret] = nil
        return false, "Could not download the main script."
    end

    local fn, compileErr = loadstring(source)
    if type(fn) ~= "function" then
        _G[Config.Secret] = nil
        return false, "Could not compile the main script."
    end

    local runOk = pcall(fn)
    if not runOk then
        _G[Config.Secret] = nil
        return false, "Main script returned an error."
    end

    return true
end

local function createGui()
    local parent = player:WaitForChild("PlayerGui")
    local old = parent:FindFirstChild("RIVALS_WorkInk_KeySystem")
    if old then old:Destroy() end

    local gui = Instance.new("ScreenGui")
    gui.Name = "RIVALS_WorkInk_KeySystem"
    gui.ResetOnSpawn = false
    gui.Parent = parent

    local frame = Instance.new("Frame")
    frame.Size = UDim2.fromOffset(360, 300)
    frame.Position = UDim2.new(0.5, -180, 0.5, -150)
    frame.BackgroundColor3 = Color3.fromRGB(15, 15, 18)
    frame.BorderSizePixel = 0
    frame.Active = true
    frame.Draggable = true
    frame.Parent = gui
    Instance.new("UICorner", frame).CornerRadius = UDim.new(0, 14)

    local title = Instance.new("TextLabel")
    title.Size = UDim2.new(1, -30, 0, 45)
    title.Position = UDim2.fromOffset(15, 10)
    title.BackgroundTransparency = 1
    title.Text = Config.HubName
    title.TextColor3 = Color3.fromRGB(240,240,245)
    title.TextXAlignment = Enum.TextXAlignment.Left
    title.Font = Enum.Font.GothamBold
    title.TextSize = 20
    title.Parent = frame

    local desc = Instance.new("TextLabel")
    desc.Size = UDim2.new(1, -30, 0, 35)
    desc.Position = UDim2.fromOffset(15, 52)
    desc.BackgroundTransparency = 1
    desc.Text = Config.HubDescription
    desc.TextColor3 = Color3.fromRGB(150,150,160)
    desc.Font = Enum.Font.Gotham
    desc.TextSize = 13
    desc.Parent = frame

    local input = Instance.new("TextBox")
    input.Size = UDim2.new(1, -30, 0, 42)
    input.Position = UDim2.fromOffset(15, 100)
    input.BackgroundColor3 = Color3.fromRGB(28,28,34)
    input.BorderSizePixel = 0
    input.PlaceholderText = "Paste your Work.ink key..."
    input.Text = ""
    input.TextColor3 = Color3.fromRGB(240,240,245)
    input.Font = Enum.Font.Gotham
    input.TextSize = 14
    input.ClearTextOnFocus = false
    input.Parent = frame
    Instance.new("UICorner", input).CornerRadius = UDim.new(0, 9)

    local verify = Instance.new("TextButton")
    verify.Size = UDim2.new(0.46, 0, 0, 40)
    verify.Position = UDim2.fromOffset(15, 158)
    verify.BackgroundColor3 = Color3.fromRGB(65,105,225)
    verify.BorderSizePixel = 0
    verify.Text = "VERIFY"
    verify.TextColor3 = Color3.new(1,1,1)
    verify.Font = Enum.Font.GothamBold
    verify.TextSize = 14
    verify.Parent = frame
    Instance.new("UICorner", verify).CornerRadius = UDim.new(0, 9)

    local getKey = Instance.new("TextButton")
    getKey.Size = UDim2.new(0.46, 0, 0, 40)
    getKey.Position = UDim2.new(0.54, -15, 0, 158)
    getKey.BackgroundColor3 = Color3.fromRGB(35,35,42)
    getKey.BorderSizePixel = 0
    getKey.Text = "GET KEY"
    getKey.TextColor3 = Color3.new(1,1,1)
    getKey.Font = Enum.Font.GothamBold
    getKey.TextSize = 14
    getKey.Parent = frame
    Instance.new("UICorner", getKey).CornerRadius = UDim.new(0, 9)

    local status = Instance.new("TextLabel")
    status.Size = UDim2.new(1, -30, 0, 60)
    status.Position = UDim2.fromOffset(15, 215)
    status.BackgroundTransparency = 1
    status.Text = "Waiting for input..."
    status.TextWrapped = true
    status.TextColor3 = Color3.fromRGB(145,145,155)
    status.Font = Enum.Font.Gotham
    status.TextSize = 12
    status.Parent = frame

    local busy = false

    local function verifyAndStart(key)
        if busy then return end
        busy = true
        status.Text = "Verifying..."

        task.spawn(function()
            local valid, msg = verifyKey(key)

            if not valid then
                status.Text = msg
                status.TextColor3 = Color3.fromRGB(235,90,90)
                busy = false
                return
            end

            saveKey(key)
            status.Text = "Key valid. Loading..."
            status.TextColor3 = Color3.fromRGB(80,220,130)

            task.wait(0.2)

            local started, err = startMainScript()
            if started then
                gui:Destroy()
            else
                status.Text = err or "Could not load."
                status.TextColor3 = Color3.fromRGB(235,90,90)
                busy = false
            end
        end)
    end

    verify.MouseButton1Click:Connect(function()
        verifyAndStart(input.Text)
    end)

    getKey.MouseButton1Click:Connect(function()
        if copyLink() then
            status.Text = "Work.ink link copied."
        else
            status.Text = Config.WorkInkURL
        end
        status.TextColor3 = Color3.fromRGB(100,170,255)
    end)

    local saved = getSavedKey()
    if saved then
        input.Text = saved
        task.defer(verifyAndStart, saved)
    end
end

createGui()
